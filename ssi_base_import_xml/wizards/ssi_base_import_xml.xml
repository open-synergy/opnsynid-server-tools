<odoo>

    <record id="ssi_base_import_xml_view_form" model="ir.ui.view">
        <field name="name">Import from XML</field>
        <field name="model">base_import_xml</field>
        <field name="arch" type="xml">
            <form string="Import from XML">
                <group>
                    <field name="model_name" readonly="1" />
                    <field
                        name="file_data"
                        filename="file_name"
                        widget="binary"
                        string="XML File"
                    />
                    <field name="file_name" invisible="1" />
                </group>
                <group
                    attrs="{'invisible': [('error_message', '=', False)]}"
                    string="Messages"
                >
                    <field
                        name="error_message"
                        nolabel="1"
                        widget="text"
                        readonly="1"
                        style="min-height: 120px; font-family: monospace;"
                    />
                </group>
                <footer>
                    <button
                        name="action_import"
                        string="Import"
                        type="object"
                        class="oe_highlight"
                    />
                    <button string="Close" class="btn btn-secondary" special="cancel" />
                </footer>
            </form>
        </field>
    </record>

    <record id="ssi_base_import_xml_action" model="ir.actions.act_window">
        <field name="name">Import from XML</field>
        <field name="res_model">base_import_xml</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="ssi_base_import_xml_view_form" />
        <field name="target">new</field>
    </record>

</odoo>
