<odoo>

    <record id="base_copy_user_operating_unit_view_form" model="ir.ui.view">
        <field name="name">Copy User Operating Unit</field>
        <field name="model">base.copy_user_operating_unit</field>
        <field name="arch" type="xml">
            <form string="Copy Operating Unit From User">
                <group colspan="4" cols="2">
                    <field name="user_id" required="True" />
                    <field name="copy_allowed_ou" />
                    <field
                        name="allowed_ou_mode"
                        attrs="{'invisible': [('copy_allowed_ou', '=', False)], 'required': [('copy_allowed_ou', '=', True)]}"
                    />
                    <field name="copy_default_ou" />
                </group>
                <footer>
                    <button
                        name="action_copy_operating_unit"
                        string="Copy"
                        type="object"
                        class="oe_highlight"
                    />
                    <button
                        string="Cancel"
                        class="btn btn-secondary"
                        special="cancel"
                    />
                </footer>
            </form>
        </field>
    </record>

    <record id="base_copy_user_operating_unit_action" model="ir.actions.act_window">
        <field name="name">Copy User Operating Unit</field>
        <field name="res_model">base.copy_user_operating_unit</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="base_copy_user_operating_unit_view_form" />
        <field name="target">new</field>
        <field name="binding_model_id" ref="base.model_res_users" />
        <field name="binding_view_types">list,form</field>
    </record>

</odoo>
