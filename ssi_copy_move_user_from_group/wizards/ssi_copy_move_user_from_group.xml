<odoo>

    <record id="ssi_copy_move_user_from_group_view_form" model="ir.ui.view">
        <field name="name">ssi_copy_move_user_from_group.view.form</field>
        <field name="model">ssi_copy_move_user_from_group</field>
        <field name="arch" type="xml">
            <form string="Copy/Move User From Group">
                <group colspan="4" cols="2">
                    <field name="group_from_id" />
                    <field name="group_to_id" />
                    <field name="user_ids" widget="many2many_tags" />
                </group>
                <footer>
                    <button
                        name="action_copy_users"
                        string="Copy Users"
                        type="object"
                        class="oe_highlight"
                    />
                    <button
                        name="action_move_users"
                        string="Move Users"
                        type="object"
                        class="btn btn-primary"
                    />
                    <button
                        string="Cancel"
                        class="btn btn-secondary"
                        special="cancel"
                    />
                </footer>
            </form>
        </field>
    </record>

    <record id="ssi_copy_move_user_from_group_action" model="ir.actions.act_window">
        <field name="name">Copy/Move User From Group</field>
        <field name="res_model">ssi_copy_move_user_from_group</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="ssi_copy_move_user_from_group_view_form" />
        <field name="target">new</field>
        <field name="binding_model_id" ref="base.model_res_groups" />
        <field name="binding_view_types">form</field>
    </record>

</odoo>
