<odoo>
    <!-- Rows are written only through the source mixin (sudo), so every
         group, including the administrator, is read-only. -->
    <record id="super_calendar_all_access" model="ir.model.access">
        <field name="name">super_calendar - all</field>
        <field name="model_id" ref="model_super_calendar" />
        <field name="group_id" ref="base.group_user" />
        <field name="perm_read" eval="1" />
        <field name="perm_write" eval="0" />
        <field name="perm_create" eval="0" />
        <field name="perm_unlink" eval="0" />
    </record>
    <record id="super_calendar_system_access" model="ir.model.access">
        <field name="name">super_calendar - system</field>
        <field name="model_id" ref="model_super_calendar" />
        <field name="group_id" ref="base.group_system" />
        <field name="perm_read" eval="1" />
        <field name="perm_write" eval="0" />
        <field name="perm_create" eval="0" />
        <field name="perm_unlink" eval="0" />
    </record>
</odoo>
