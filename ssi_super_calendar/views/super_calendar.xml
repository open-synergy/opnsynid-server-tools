<odoo>
    <record id="super_calendar_view_search" model="ir.ui.view">
        <field name="name">super_calendar - Search</field>
        <field name="model">super_calendar</field>
        <field name="arch" type="xml">
            <search>
                <field name="partner_ids" />
                <filter
                    name="dom_applies_to_all"
                    string="Applies to Everyone"
                    domain="[('applies_to_all','=',True)]"
                />
                <filter
                    name="dom_inactive"
                    string="Archived"
                    domain="[('active','=',False)]"
                />
            </search>
        </field>
    </record>

    <record id="super_calendar_view_tree" model="ir.ui.view">
        <field name="name">super_calendar - Tree</field>
        <field name="model">super_calendar</field>
        <field name="arch" type="xml">
            <tree create="0" edit="0" delete="0">
                <field name="display_name" />
                <field name="date_start" />
                <field name="date_end" />
                <field name="allday" />
                <field name="applies_to_all" />
                <field name="partner_count" />
            </tree>
        </field>
    </record>

    <record id="super_calendar_view_calendar" model="ir.ui.view">
        <field name="name">super_calendar - Calendar</field>
        <field name="model">super_calendar</field>
        <field name="arch" type="xml">
            <calendar
                string="Super Calendar"
                date_start="date_start"
                date_stop="date_end"
                all_day="allday"
                mode="month"
                quick_add="False"
            >
                <field name="display_name" />
            </calendar>
        </field>
    </record>

    <record id="super_calendar_view_form" model="ir.ui.view">
        <field name="name">super_calendar - Form</field>
        <field name="model">super_calendar</field>
        <field name="arch" type="xml">
            <form create="0" edit="0" delete="0">
                <header>
                    <button
                        name="action_open_source_document"
                        type="object"
                        string="Open Source Document"
                        attrs="{'invisible': [('source_ref', '=', False)]}"
                    />
                </header>
                <sheet>
                    <group name="group_1" colspan="4" col="2">
                        <field name="display_name" />
                        <field name="source_ref" />
                        <field name="date_start" />
                        <field name="date_end" />
                        <field name="allday" />
                        <field name="applies_to_all" />
                        <field name="partner_count" />
                        <field name="active" />
                    </group>
                    <group name="group_2" colspan="4" col="2">
                        <field name="partner_ids" widget="many2many_tags" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="super_calendar_action" model="ir.actions.act_window">
        <field name="name">Super Calendar</field>
        <field name="res_model">super_calendar</field>
        <field name="view_mode">calendar,tree,form</field>
    </record>

    <!-- Only the action of the core Calendar app menu is re-pointed.
         name, parent, sequence, web_icon and groups stay as in core, and
         calendar.action_calendar_event is left untouched. -->
    <record id="calendar.mail_menu_calendar" model="ir.ui.menu">
        <field name="action" ref="ssi_super_calendar.super_calendar_action" />
    </record>
</odoo>
