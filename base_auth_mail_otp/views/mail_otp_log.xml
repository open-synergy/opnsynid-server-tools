<odoo>
    <record id="mail_otp_log_view_search" model="ir.ui.view">
        <field name="name">mail_otp_log - search</field>
        <field name="model">mail_otp_log</field>
        <field name="arch" type="xml">
            <search>
                <field name="user_id" />
                <field name="event" />
                <field name="ip_address" />
                <group name="group_by" expand="0" string="Group By">
                    <filter
                        name="grp_user"
                        string="User"
                        context="{'group_by': 'user_id'}"
                    />
                    <filter
                        name="grp_event"
                        string="Event"
                        context="{'group_by': 'event'}"
                    />
                </group>
            </search>
        </field>
    </record>

    <record id="mail_otp_log_view_tree" model="ir.ui.view">
        <field name="name">mail_otp_log - tree</field>
        <field name="model">mail_otp_log</field>
        <field name="arch" type="xml">
            <tree create="0" edit="0" delete="0">
                <field name="create_date" />
                <field name="user_id" />
                <field name="event" />
                <field name="challenge_id" optional="hide" />
                <field name="ip_address" optional="show" />
                <field name="note" />
            </tree>
        </field>
    </record>

    <record id="mail_otp_log_view_form" model="ir.ui.view">
        <field name="name">mail_otp_log - form</field>
        <field name="model">mail_otp_log</field>
        <field name="arch" type="xml">
            <form create="0" edit="0" delete="0">
                <sheet>
                    <group name="group_1" colspan="4" col="2">
                        <field name="user_id" />
                        <field name="challenge_id" />
                        <field name="event" />
                        <field name="ip_address" />
                        <field name="user_agent" />
                        <field name="note" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="mail_otp_log_action" model="ir.actions.act_window">
        <field name="name">Logs</field>
        <field name="res_model">mail_otp_log</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem
        id="mail_otp_log_menu"
        name="Logs"
        parent="menu_mail_otp"
        action="mail_otp_log_action"
        sequence="30"
        groups="base.group_system"
    />
</odoo>
