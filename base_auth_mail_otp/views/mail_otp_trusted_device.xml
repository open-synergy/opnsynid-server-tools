<odoo>
    <record id="mail_otp_trusted_device_view_search" model="ir.ui.view">
        <field name="name">mail_otp_trusted_device - search</field>
        <field name="model">mail_otp_trusted_device</field>
        <field name="arch" type="xml">
            <search>
                <field name="user_id" />

                <group name="group_by" expand="0" string="Group By">
                    <filter
                        name="grp_user"
                        string="User"
                        context="{'group_by': 'user_id'}"
                    />

                </group>
            </search>
        </field>
    </record>

    <record id="mail_otp_trusted_device_view_tree" model="ir.ui.view">
        <field name="name">mail_otp_trusted_device - tree</field>
        <field name="model">mail_otp_trusted_device</field>
        <field name="arch" type="xml">
            <tree create="0" edit="0">
                <field name="create_date" />
                <field name="user_id" />
                <field name="expiration_date" />
                <field name="last_used_date" />
                <field name="ip_address" optional="show" />
                <field name="user_agent" optional="hide" />
            </tree>
        </field>
    </record>

    <record id="mail_otp_trusted_device_view_form" model="ir.ui.view">
        <field name="name">mail_otp_trusted_device - form</field>
        <field name="model">mail_otp_trusted_device</field>
        <field name="arch" type="xml">
            <form create="0" edit="0">
                <sheet>
                    <group name="group_1" colspan="4" col="2">
                        <field name="user_id" />
                        <field name="expiration_date" />
                        <field name="last_used_date" />
                        <field name="ip_address" />
                        <field name="user_agent" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="mail_otp_trusted_device_action" model="ir.actions.act_window">
        <field name="name">Trusted Devices</field>
        <field name="res_model">mail_otp_trusted_device</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem
        id="mail_otp_trusted_device_menu"
        name="Trusted Devices"
        parent="menu_mail_otp"
        action="mail_otp_trusted_device_action"
        sequence="20"
        groups="base.group_system"
    />
</odoo>
