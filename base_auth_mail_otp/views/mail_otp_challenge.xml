<odoo>
    <record id="mail_otp_challenge_view_search" model="ir.ui.view">
        <field name="name">mail_otp_challenge - search</field>
        <field name="model">mail_otp_challenge</field>
        <field name="arch" type="xml">
            <search>
                <field name="user_id" />
                <field name="state" />
                <group name="group_by" expand="0" string="Group By">
                    <filter
                        name="grp_user"
                        string="User"
                        context="{'group_by': 'user_id'}"
                    />
                    <filter
                        name="grp_state"
                        string="State"
                        context="{'group_by': 'state'}"
                    />
                </group>
            </search>
        </field>
    </record>

    <record id="mail_otp_challenge_view_tree" model="ir.ui.view">
        <field name="name">mail_otp_challenge - tree</field>
        <field name="model">mail_otp_challenge</field>
        <field name="arch" type="xml">
            <tree create="0" edit="0" delete="0">
                <field name="create_date" />
                <field name="user_id" />
                <field name="state" />
                <field name="attempt_count" />
                <field name="expiration_date" />
                <field name="ip_address" optional="show" />
                <field name="user_agent" optional="hide" />
            </tree>
        </field>
    </record>

    <record id="mail_otp_challenge_view_form" model="ir.ui.view">
        <field name="name">mail_otp_challenge - form</field>
        <field name="model">mail_otp_challenge</field>
        <field name="arch" type="xml">
            <form create="0" edit="0" delete="0">
                <sheet>
                    <group name="group_1" colspan="4" col="2">
                        <field name="user_id" />
                        <field name="state" />
                        <field name="attempt_count" />
                        <field name="expiration_date" />
                        <field name="last_sent_date" />
                        <field name="ip_address" />
                        <field name="user_agent" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="mail_otp_challenge_action" model="ir.actions.act_window">
        <field name="name">Challenges</field>
        <field name="res_model">mail_otp_challenge</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem
        id="mail_otp_challenge_menu"
        name="Challenges"
        parent="menu_mail_otp"
        action="mail_otp_challenge_action"
        sequence="10"
        groups="base.group_system"
    />
</odoo>
